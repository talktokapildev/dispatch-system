// backend/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────

enum LostPropertyStatus {
  REPORTED
  FOUND
  RETURNED
  CLOSED
}

enum UserRole {
  PASSENGER
  DRIVER
  ADMIN
  DISPATCHER
  CORPORATE_ADMIN
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  DRIVER_ASSIGNED
  DRIVER_EN_ROUTE
  DRIVER_ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
  SCHEDULED_OPEN
}

enum BookingType {
  ASAP
  PREBOOKED
  AIRPORT_PICKUP
  AIRPORT_DROPOFF
  CORPORATE
  CAREHOME
}

enum PricingType {
  FIXED
  METERED
}

enum PaymentMethod {
  CARD
  CASH
  APPLE_PAY
  GOOGLE_PAY
  ACCOUNT
  INVOICE
}

enum PaymentStatus {
  PENDING
  AUTHORISED
  CAPTURED
  REFUNDED
  FAILED
  CASH
}

enum WalletTxType {
  CREDIT_PROMO
  DEBIT_TRIP
  REFUND_CANCEL
  REFUND_ADMIN
  EXPIRY
  CASH_ADJUSTMENT
}

enum PromoTarget {
  ALL_PASSENGERS
  NEW_PASSENGERS_ONLY
}

enum DriverStatus {
  OFFLINE
  AVAILABLE
  ON_JOB
  BREAK
}

enum VehicleClass {
  STANDARD
  EXECUTIVE
  MPV
  MINIBUS
}

enum DocumentType {
  PCO_LICENSE
  DRIVING_LICENSE
  DRIVING_LICENSE_BACK // ← ADD THIS
  PHV_LICENCE // ← ADD THIS
  VEHICLE_INSURANCE
  MOT_CERTIFICATE
  V5C_LOGBOOK
  DBS_CHECK
  PROFILE_PHOTO
  VEHICLE_PHOTO
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum CorporateInvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
}

enum CareHomeAccountStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum ResidentMobility {
  AMBULATORY
  WALKING_AID
  WHEELCHAIR
  WHEELCHAIR_ASSIST
  STRETCHER
}

enum RecurrencePattern {
  DAILY
  WEEKLY
  FORTNIGHTLY
  MONTHLY
}

// ─────────────────────────────────────────
// CORE USER
// ─────────────────────────────────────────

model User {
  id           String     @id @default(uuid())
  phone        String     @unique
  email        String?    @unique
  firstName    String
  lastName     String
  roles        UserRole[] // ← changed from role UserRole (single) to roles UserRole[] (array)
  isActive     Boolean    @default(true)
  isVerified   Boolean    @default(false)
  passwordHash String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  passenger          Passenger?
  driver             Driver?
  adminProfile       AdminProfile?
  otpCodes           OtpCode[]
  refreshTokens      RefreshToken[]
  dispatchedBookings Booking[]      @relation("BookingDispatcher")
  recordedBookings   Booking[]      @relation("BookingRecorder")

  @@index([phone])
  @@index([email])
}

model OtpCode {
  id        String   @id @default(uuid())
  userId    String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

// ─────────────────────────────────────────
// PASSENGER
// ─────────────────────────────────────────

model Passenger {
  id                 String   @id @default(uuid())
  userId             String   @unique
  stripeCustomerId   String?
  savedAddresses     Json     @default("[]")
  corporateAccountId String?
  totalRides         Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  lostProperties LostProperty[]

  user             User                 @relation(fields: [userId], references: [id])
  corporateAccount CorporateAccount?    @relation(fields: [corporateAccountId], references: [id])
  bookings         Booking[]
  paymentMethods   SavedPaymentMethod[]
  wallet           WalletAccount?

  @@index([userId])
}

model SavedPaymentMethod {
  id                    String   @id @default(uuid())
  passengerId           String
  stripePaymentMethodId String
  brand                 String
  last4                 String
  expiryMonth           Int
  expiryYear            Int
  isDefault             Boolean  @default(false)
  createdAt             DateTime @default(now())

  passenger Passenger @relation(fields: [passengerId], references: [id])
}

// ─────────────────────────────────────────
// DRIVER
// ─────────────────────────────────────────

model Driver {
  id                   String       @id @default(uuid())
  userId               String       @unique
  pcoBadgeNumber       String       @unique
  pcoLicenseExpiry     DateTime
  drivingLicenseNumber String
  status               DriverStatus @default(OFFLINE)
  photoUrl             String?
  currentLatitude      Float?
  currentLongitude     Float?
  currentBearing       Float?
  lastLocationAt       DateTime?
  rating               Float        @default(5.0)
  totalJobs            Int          @default(0)
  stripeAccountId      String?
  onboardingComplete   Boolean      @default(false)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  archivedAt           DateTime?
  archivedBy           String?

  user             User              @relation(fields: [userId], references: [id])
  vehicle          Vehicle?
  register         DriverRegister?
  engagements      DriverEngagement[]
  vehicleHistory   VehicleAssignment[]
  documents        DriverDocument[]
  bookings         Booking[]
  earnings         DriverEarning[]
  breaks           DriverBreak[]
  teslaIntegration TeslaIntegration?

  @@index([userId])
  @@index([status])
}

// TfL driver register details (template "PRIVATE HIRE DRIVER"). Kept OUT of Driver on purpose:
// many endpoints (passenger bookings included) return whole Driver rows, and these personal
// details must only ever be read by the admin register endpoints.
// Dates are calendar days stored as 00:00 UTC of that day.
model DriverRegister {
  driverId         String    @id
  middleNames      String?
  callSign         String?   @unique
  address          String? // multi-line, as on the driver's documents
  postcode         String?
  dateOfBirth      DateTime?
  niNumber         String? // National Insurance number, capitals, no spaces
  licenceCheckedAt DateTime? // DVLA driving licence last checked (check code)
  updatedBy        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)
}

// TfL driver register: one row per period the driver was available to carry out bookings
// ("Date first available" / "Date of leaving", then "Restart" / "Finish"). endedAt null = current.
model DriverEngagement {
  id                  String    @id @default(uuid())
  driverId            String
  startedAt           DateTime // calendar day, 00:00 UTC
  endedAt             DateTime? // calendar day, 00:00 UTC
  endReason           String?
  dismissedForConduct Boolean   @default(false)
  notes               String?
  startedBy           String? // userId of the admin
  endedBy             String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId])
}

// A vehicle exists on its own. A driver has at most one current vehicle (driverId is unique, null
// when unassigned). Retired vehicles have archivedAt set, isActive false and no driver; they stay
// on the bookings they did. Bookings record the vehicle used (Booking.vehicleId).
model Vehicle {
  id               String       @id @default(uuid())
  driverId         String?      @unique
  make             String
  model            String
  year             Int
  colour           String
  licensePlate     String       @unique
  phvLicenceNumber String?
  phvLicenceExpiry DateTime?
  phvDiscNumber    String?
  class            VehicleClass @default(STANDARD)
  seats            Int          @default(4)
  motExpiry        DateTime
  insuranceExpiry  DateTime
  emissionStandard String?
  isUlezCompliant  Boolean      @default(false)
  isActive         Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  archivedAt       DateTime? // retired = "vehicle ceased" on TfL's vehicle record
  notes            String?
  // TfL vehicle record
  keeperName       String? // registered keeper (V5C)
  keeperAddress    String?
  startDate        DateTime  @default(now()) // started working for OrangeRide

  driver         Driver?                @relation(fields: [driverId], references: [id], onDelete: SetNull)
  bookings       Booking[]
  documents      DriverDocument[]
  assignments    VehicleAssignment[]
  servicePeriods VehicleServicePeriod[]
}

// History of which driver had which car. Written ONLY by the database trigger
// "vehicle_history" on "Vehicle" (migration 20261018200000_vehicle_history): every change of
// Vehicle.driverId closes the open row and opens a new one, whichever code path made it.
model VehicleAssignment {
  id         String    @id @default(uuid())
  vehicleId  String
  driverId   String? // null once the driver's record has been deleted (driverName is kept)
  driverName String // name when the car was assigned
  startedAt  DateTime
  endedAt    DateTime?
  endReason  String? // Reassigned, Unassigned, Driver left, Vehicle retired
  note       String?
  createdAt  DateTime  @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driver  Driver? @relation(fields: [driverId], references: [id], onDelete: SetNull)

  @@index([vehicleId])
  @@index([driverId])
}

// TfL vehicle record "Start Date / Vehicle Ceased": the periods a car was on the fleet. Written
// ONLY by the "vehicle_history" trigger (retire closes, restore opens, editing Vehicle.startDate
// moves the first period's start).
model VehicleServicePeriod {
  id        String    @id @default(uuid())
  vehicleId String
  startedAt DateTime
  endedAt   DateTime?
  createdAt DateTime  @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
}

// A driver or vehicle document. Each upload is a new version: the approved version stays in force
// until a newer one is approved (it is then marked replaced) or it expires. Nothing is overwritten,
// so the history is kept for TfL records.
// Owner: driver documents (PCO badge, driving licence, DBS, profile photo) have vehicleId null.
// Vehicle documents (PHV vehicle licence, insurance, MOT, V5C, vehicle photo) have vehicleId set;
// driverId is then only the driver who uploaded it (may be null).
model DriverDocument {
  id                String         @id @default(uuid())
  driverId          String?
  vehicleId         String?
  type              DocumentType
  status            DocumentStatus @default(PENDING)
  fileUrl           String
  pageUrls          String[]       @default([]) // extra pages (insurance, V5C)
  expiryDate        DateTime? // valid to the end of this UK day
  expiryGraceUntil  DateTime? // approved before expiry dates were required: counts as valid until then
  notes             String? // admin notes (internal)
  rejectionReason   String? // shown to the driver
  uploadedBy        String? // userId of the driver or admin who uploaded it
  reviewedAt        DateTime?
  reviewedBy        String?
  replacedAt        DateTime? // a newer version was approved (or this was merged as a page)
  replacedById      String?
  lastReminderDays  Int? // last expiry reminder sent (30, 14, 7, 1 days before)
  expiredNotifiedAt DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  archivedAt        DateTime?

  driver  Driver?  @relation(fields: [driverId], references: [id], onDelete: Restrict)
  vehicle Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([driverId])
  @@index([vehicleId])
  @@index([status])
  @@index([expiryDate])
}

model DriverBreak {
  id        String    @id @default(uuid())
  driverId  String
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  driver Driver @relation(fields: [driverId], references: [id])
}

// ─────────────────────────────────────────
// ADMIN
// ─────────────────────────────────────────

model AdminProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  permissions Json     @default("[]")
  createdAt   DateTime @default(now())

  // TfL Condition 19: staff register
  dateOfBirth          DateTime?
  dbsCertificateNumber String?
  dbsCheckDate         DateTime?

  user User @relation(fields: [userId], references: [id])
}

// ─────────────────────────────────────────
// CORPORATE ACCOUNTS
// ─────────────────────────────────────────

model CorporateAccount {
  id               String   @id @default(uuid())
  name             String
  contactName      String
  contactEmail     String
  contactPhone     String
  address          String
  invoicingEmail   String
  paymentTermsDays Int      @default(30)
  creditLimit      Float    @default(0)
  currentBalance   Float    @default(0)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  passengers Passenger[]
  bookings   Booking[]
  invoices   CorporateInvoice[]

  @@index([name])
}

model CorporateInvoice {
  id                 String                 @id @default(uuid())
  corporateAccountId String
  invoiceNumber      String                 @unique
  periodFrom         DateTime
  periodTo           DateTime
  totalAmount        Float
  status             CorporateInvoiceStatus @default(DRAFT)
  dueDate            DateTime
  paidAt             DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  corporateAccount CorporateAccount @relation(fields: [corporateAccountId], references: [id])
  bookings         Booking[]

  @@index([corporateAccountId])
}

// ─────────────────────────────────────────
// BOOKINGS
// ─────────────────────────────────────────

model Booking {
  id                 String  @id @default(uuid())
  reference          String  @unique
  passengerId        String?
  driverId           String?
  corporateAccountId String?
  corporateInvoiceId String?

  type   BookingType
  status BookingStatus @default(PENDING)

  // Locations
  pickupAddress    String
  pickupLatitude   Float
  pickupLongitude  Float
  dropoffAddress   String
  dropoffLatitude  Float
  dropoffLongitude Float
  stops            Json   @default("[]")

  // Timing
  scheduledAt      DateTime?
  dispatchedAt     DateTime?
  driverAcceptedAt DateTime?
  driverArrivedAt  DateTime?
  tripStartedAt    DateTime?
  completedAt      DateTime?

  // TfL Compliance: dispatcher record (Condition 6)
  dispatchedBy String?

  // How/when the passenger made the booking (e.g. WHATSAPP at 14 Oct 15:40), and whether the
  // trip was entered in the system after it happened (admin "Record completed trip").
  bookedVia         String? // APP | WHATSAPP | PHONE | EMAIL | IN_PERSON
  bookedAt          DateTime?
  recordedAfterTrip Boolean   @default(false)
  recordedBy        String?

  // Scheduled job-board (added for advance-booking driver claim flow)
  claimedAt DateTime? // set when a driver claims this from the open job board

  // TfL Compliance: PHV licence number at time of booking (Condition — booking record requirement)
  driverPhvLicenceNumber String?
  vehicleId              String? // TfL: the vehicle that did (or will do) the trip

  // Pricing
  pricingType     PricingType @default(FIXED)
  estimatedFare   Float
  actualFare      Float?
  surgeMultiplier Float       @default(1.0)
  driverEarning   Float?
  platformFee     Float?

  // Dynamic fare fields (added for actual distance/time tracking)
  actualDistance         Float?
  actualDuration         Int?
  estimatedRoutePolyline String? // Google encoded polyline, filled lazily on first map view
  actualRoutePolyline    String? // Google encoded polyline sent by driver app at completion (Phase 2)
  tipAmount              Float?
  tipPaymentIntentId     String?
  cashReceived           Float?

  // Wallet Phase 1: cash settlement
  suggestedCashCollection Float?
  actualCashCollected     Float?

  // Payment
  paymentMethod         PaymentMethod @default(CARD)
  paymentStatus         PaymentStatus @default(PENDING)
  stripePaymentIntentId String?

  // Flight details
  flightNumber      String?
  flightArrivalTime DateTime?
  terminal          String?

  // Airport pickups (flight capture)
  meetingPointId          String?
  meetingPoint            AirportMeetingPoint? @relation(fields: [meetingPointId], references: [id])
  luggageType             String? // "HAND" | "CHECKED"
  flightSnapshot          Json? // AeroDataBox data: refreshed/cleared by daily job (6-day max age)
  flightSnapshotFetchedAt DateTime?

  // Flight tracking (Phase 2) — ours, kept permanently
  pickupOffsetMinutes Int? // minutes after gate arrival (luggage buffer + passenger's extra)
  bookedPickupAt      DateTime? // agreed pickup: at booking, or later confirmed by driver/admin
  flightWatchId       String?
  flightWatch         FlightWatch?         @relation(fields: [flightWatchId], references: [id])
  flightEvents        BookingFlightEvent[]

  // Misc
  passengerCount     Int     @default(1)
  notes              String?
  operatorNotes      String?
  cancellationReason String?
  rating             Int?
  feedback           String?
  dispatchAttempts   Int     @default(0)

  // Quick-win fields
  pickupZone             String?
  dropoffZone            String?
  fixedPriceOverride     Float?
  isOnHold               Boolean   @default(false)
  allocationTime         DateTime?
  requiredCarFeatures    Json      @default("[]")
  requiredDriverFeatures Json      @default("[]")
  department             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lostProperties LostProperty[]

  passenger        Passenger?             @relation(fields: [passengerId], references: [id])
  driver           Driver?                @relation(fields: [driverId], references: [id])
  vehicle          Vehicle?               @relation(fields: [vehicleId], references: [id])
  corporateAccount CorporateAccount?      @relation(fields: [corporateAccountId], references: [id])
  corporateInvoice CorporateInvoice?      @relation(fields: [corporateInvoiceId], references: [id])
  statusHistory    BookingStatusHistory[]
  receipt          Receipt?
  dispatchedByUser User?                  @relation("BookingDispatcher", fields: [dispatchedBy], references: [id])
  recordedByUser   User?                  @relation("BookingRecorder", fields: [recordedBy], references: [id])

  // Care home
  careHomeId         String?
  careHome           CareHomeAccount?  @relation(fields: [careHomeId], references: [id])
  residentId         String?
  resident           CareHomeResident? @relation(fields: [residentId], references: [id])
  recurringBookingId String?
  recurringBooking   RecurringBooking? @relation(fields: [recurringBookingId], references: [id])
  careHomeInvoiceId  String?
  careHomeInvoice    CareHomeInvoice?  @relation(fields: [careHomeInvoiceId], references: [id])

  @@index([passengerId])
  @@index([driverId])
  @@index([vehicleId])
  @@index([status])
  @@index([scheduledAt])
  @@index([reference])
  @@index([dispatchedBy])
  @@index([recordedBy])
  @@index([status, scheduledAt]) // job board queries: open jobs sorted by pickup time
  @@index([flightSnapshotFetchedAt])
  @@index([flightWatchId])
}

model BookingStatusHistory {
  id        String        @id @default(uuid())
  bookingId String
  status    BookingStatus
  note      String?
  createdAt DateTime      @default(now())

  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([bookingId])
}

model Receipt {
  id                    String   @id @default(uuid())
  bookingId             String   @unique
  receiptNumber         String   @unique
  operatorName          String
  operatorLicenseNumber String
  driverName            String
  driverPcoBadge        String
  vehiclePlate          String
  vehicleDescription    String
  pickupAddress         String
  dropoffAddress        String
  tripDistance          Float?
  tripDuration          Int?
  fareBreakdown         Json
  totalAmount           Float
  paymentMethod         String
  issuedAt              DateTime @default(now())
  // Added with admin receipts (all optional so older rows stay valid)
  passengerName         String?
  billTo                String? // optional company name for expense claims
  operatorAddress       String?
  pickupAt              DateTime?
  dropoffAt             DateTime?
  updatedAt             DateTime? @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id])
}

// ─────────────────────────────────────────
// PRICING CONFIG
// ─────────────────────────────────────────

model PricingConfig {
  id String @id @default(uuid())

  baseFare    Float @default(2.00)
  perMinute   Float @default(0.20)
  minimumFare Float @default(10.00)

  // Tiered distance pricing (blended/progressive — replaces the old flat
  // perMile rate). Miles up to tierThresholdMiles are charged at
  // perMileFirstTier; any miles beyond that are charged at
  // perMileAfterTier. Same rate applies to ASAP and Scheduled bookings.
  perMileFirstTier   Float @default(2.00)
  perMileAfterTier   Float @default(1.80)
  tierThresholdMiles Float @default(20)

  platformCommission Float @default(0.15)

  nightPremium        Float @default(0.25)
  nightStartHour      Int   @default(23)
  nightEndHour        Int   @default(6)
  bankHolidayPremium  Float @default(0.25)
  christmasNyePremium Float @default(0.75)

  gatwickDropoff  Float @default(10.00)
  gatwickPickup   Float @default(10.00)
  heathrowDropoff Float @default(7.00)
  heathrowPickup  Float @default(7.00)
  meetAndGreet    Float @default(12.00)

  dartfordCrossing Float @default(2.50)
  congestionCharge Float @default(15.00)

  extraStopCharge      Float @default(5.00)
  freeWaitingMinutes   Int   @default(10)
  waitingRatePerMinute Float @default(0.50)

  retailCancelFreeMinutes Int @default(15)
  accountCancelFreeHours  Int @default(2)

  careHomeUnder3miles       Float @default(15.00)
  careHome3to7miles         Float @default(22.00)
  careHome7to15miles        Float @default(32.00)
  careHome15to25miles       Float @default(48.00)
  careHome25to40miles       Float @default(70.00)
  careHomeHospitalDischarge Float @default(10.00)
  careHomeHalfDay           Float @default(150.00)
  careHomeFullDay           Float @default(250.00)
  careHomeHourlyBeyondFull  Float @default(35.00)

  walletWelcomeBonus    Float @default(25)
  walletMonthlyPromoCap Float @default(1000)
  walletBonusExpiryDays Int   @default(90)

  updatedAt DateTime @updatedAt
  updatedBy String?
}

// ─────────────────────────────────────────
// DRIVER EARNINGS
// ─────────────────────────────────────────

model DriverEarning {
  id          String    @id @default(uuid())
  driverId    String
  bookingId   String    @unique
  grossAmount Float
  platformFee Float
  netAmount   Float
  paidOut     Boolean   @default(false)
  paidOutAt   DateTime?
  createdAt   DateTime  @default(now())

  driver Driver @relation(fields: [driverId], references: [id])

  @@index([driverId])
  @@index([paidOut])
}

// ─────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────

model Notification {
  id     String   @id @default(uuid())
  userId String
  title  String
  body   String
  data   Json?
  read   Boolean  @default(false)
  sentAt DateTime @default(now())

  @@index([userId])
  @@index([read])
}

model PushToken {
  id        String   @id @default(uuid())
  userId    String
  token     String
  platform  String
  app       String? // "driver" | "passenger" — null = registered by an older app build
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, token])
  @@index([userId])
}

// ─────────────────────────────────────────
// SURCHARGE ZONES
// ─────────────────────────────────────────

model SurchargeZone {
  id           String   @id @default(uuid())
  name         String
  type         String   @default("OTHER")
  latitude     Float
  longitude    Float
  radiusMeters Int      @default(500)
  pickupFee    Float    @default(0)
  dropoffFee   Float    @default(0)
  isActive     Boolean  @default(true)
  notes        String?
  polygon      Json?
  airportIata  String? // marks the zone that defines an airport's pickup area, e.g. "LGW"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive])
}

model LostProperty {
  id           String             @id @default(uuid())
  bookingId    String
  passengerId  String
  description  String
  contactPhone String
  status       LostPropertyStatus @default(REPORTED)
  adminNotes   String?
  reportedAt   DateTime           @default(now())
  resolvedAt   DateTime?

  booking   Booking   @relation(fields: [bookingId], references: [id])
  passenger Passenger @relation(fields: [passengerId], references: [id])

  @@index([bookingId])
  @@index([passengerId])
  @@index([status])
}

// ─────────────────────────────────────────
// CARE HOME
// ─────────────────────────────────────────

model CareHomeAccount {
  id               String                @id @default(cuid())
  name             String
  address          String
  contactName      String
  contactEmail     String
  contactPhone     String
  invoicingEmail   String
  paymentTermsDays Int                   @default(30)
  status           CareHomeAccountStatus @default(ACTIVE)
  notes            String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  residents         CareHomeResident[]
  bookings          Booking[]
  invoices          CareHomeInvoice[]
  staff             CareHomeStaff[]
  recurringBookings RecurringBooking[]
}

model CareHomeStaff {
  id           String          @id @default(cuid())
  careHomeId   String
  careHome     CareHomeAccount @relation(fields: [careHomeId], references: [id])
  name         String
  email        String          @unique
  phone        String?
  passwordHash String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model CareHomeResident {
  id           String           @id @default(cuid())
  careHomeId   String
  careHome     CareHomeAccount  @relation(fields: [careHomeId], references: [id])
  name         String
  dateOfBirth  DateTime?
  mobility     ResidentMobility @default(AMBULATORY)
  accessNotes  String?
  medicalNotes String?
  contactName  String?
  contactPhone String?
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  bookings          Booking[]
  recurringBookings RecurringBooking[]
}

model RecurringBooking {
  id             String            @id @default(cuid())
  careHomeId     String
  careHome       CareHomeAccount   @relation(fields: [careHomeId], references: [id])
  residentId     String
  resident       CareHomeResident  @relation(fields: [residentId], references: [id])
  pickupAddress  String
  pickupLat      Float?
  pickupLng      Float?
  dropoffAddress String
  dropoffLat     Float?
  dropoffLng     Float?
  pattern        RecurrencePattern
  dayOfWeek      Int?
  dayOfMonth     Int?
  scheduledTime  String
  distanceMiles  Float?
  flatFare       Float?
  notes          String?
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  bookings Booking[]
}

model CareHomeInvoice {
  id          String          @id @default(cuid())
  careHomeId  String
  careHome    CareHomeAccount @relation(fields: [careHomeId], references: [id])
  periodFrom  DateTime
  periodTo    DateTime
  dueDate     DateTime
  totalAmount Float
  isPaid      Boolean         @default(false)
  paidAt      DateTime?
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  bookings Booking[]
}

// ─────────────────────────────────────────
// DRIVER APPLICATIONS (self-onboarding)
// ─────────────────────────────────────────

model DriverApplication {
  id              String            @id @default(cuid())
  status          ApplicationStatus @default(PENDING)
  rejectionReason String?

  // Personal details
  name        String
  phone       String
  email       String?
  dateOfBirth DateTime?

  // Licence details
  pcoBadgeNumber       String
  pcoBadgeExpiry       DateTime
  drivingLicenceNumber String

  // Vehicle details
  vehicleMake             String
  vehicleModel            String
  vehicleReg              String
  vehicleYear             Int
  vehicleColour           String
  vehicleClass            String?
  vehicleSeats            Int?
  vehiclePhvLicenceNumber String?
  vehiclePhvLicenceExpiry DateTime?
  vehiclePhvDiscNumber    String?
  vehicleEmissionStandard String?
  vehicleIsUlezCompliant  Boolean?  @default(false)

  // Document URLs (Cloudinary) — uploaded per-image before submit
  docPcoBadge        String?
  docDrivingLicFront String?
  docDrivingLicBack  String?
  docPhvLicence      String?
  docInsurance       String[]
  docMot             String?
  docDbs             String? // DBS Certificate
  docV5c             String[] // V5C Logbook
  docPhvExpiry       DateTime?
  docInsuranceExpiry DateTime?
  docMotExpiry       DateTime?
  docDbsExpiry       DateTime?

  // Review meta
  reviewedBy String?
  reviewedAt DateTime?

  deletedAt DateTime?
  deletedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phone])
  @@index([status])
}

model SystemSetting {
  key       String   @id // e.g. "contactPhone", "contactEmail"
  value     String
  updatedAt DateTime @updatedAt
}

model ComplianceConfirmation {
  key         String   @id // e.g. "insurance", "licence_fee"
  confirmedAt DateTime
  confirmedBy String // adminUserId
  notes       String?
}

model TeslaIntegration {
  id           String   @id @default(cuid())
  driverId     String   @unique
  driver       Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  accessToken  String
  refreshToken String
  vehicleId    String
  vehicleName  String?
  enabled      Boolean  @default(true)
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model WalletAccount {
  id                  String   @id @default(uuid())
  passengerId         String   @unique
  promoBalance        Float    @default(0)
  realBalance         Float    @default(0)
  welcomeBonusPending Boolean  @default(true)
  welcomeBonusIssued  Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  passenger    Passenger           @relation(fields: [passengerId], references: [id])
  transactions WalletTransaction[]

  @@index([passengerId])
}

model WalletTransaction {
  id              String       @id @default(uuid())
  walletId        String
  type            WalletTxType
  amount          Float
  remainingAmount Float?
  balanceAfter    Float
  bookingId       String?
  promoCampaignId String?
  expiresAt       DateTime?
  note            String?
  createdAt       DateTime     @default(now())

  wallet   WalletAccount  @relation(fields: [walletId], references: [id])
  campaign PromoCampaign? @relation(fields: [promoCampaignId], references: [id])

  @@index([walletId])
  @@index([bookingId])
}

model PromoCampaign {
  id              String      @id @default(uuid())
  name            String
  amount          Float
  targetType      PromoTarget
  expiryDays      Int?
  isActive        Boolean     @default(true)
  totalIssued     Float       @default(0)
  totalRecipients Int         @default(0)
  createdBy       String
  createdAt       DateTime    @default(now())

  transactions WalletTransaction[]
}

model AirportMeetingPoint {
  id           String    @id @default(uuid())
  airportIata  String // e.g. "LGW"
  terminal     String // "NORTH" | "SOUTH"
  name         String // e.g. "Car Park 6, Level 4"
  instructions String
  latitude     Float
  longitude    Float
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  bookings     Booking[]

  @@unique([airportIata, terminal])
}

// One watch per flight + arrival date, shared by every booking on that flight.
model FlightWatch {
  id                    String    @id @default(uuid())
  flightNumber          String // as stored on bookings, e.g. "EZY8004"
  arrivalDate           String // YYYY-MM-DD, arrival date at the airport (local)
  airportIata           String    @default("LGW")
  subscriptionId        String? // AeroDataBox web-hook subscription
  status                String    @default("WATCHING") // WATCHING | ARRIVED | CANCELLED | DIVERTED | ENDED
  // Provider-derived (AeroDataBox) — cleared by the 6-day retention cleanup
  expectedGateArrivalAt DateTime?
  actualGateArrivalAt   DateTime?
  providerUpdatedAt     DateTime? // AeroDataBox "last updated" of the data we last applied
  // Ours
  lastCheckedAt         DateTime? // when we last received or fetched data
  unverified            Boolean   @default(false)
  createdAt             DateTime  @default(now())
  endedAt               DateTime?
  bookings              Booking[]

  @@unique([flightNumber, arrivalDate, airportIata])
  @@index([status])
}

// Milestones per booking — the admin timeline AND the "send each message once" log.
model BookingFlightEvent {
  id          String    @id @default(uuid())
  bookingId   String
  type        String // RUNNING_LATE | RUNNING_EARLY | EARLIER_CONFIRMED | ARRIVED | CANCELLED | DIVERTED | UNVERIFIED
  oldPickupAt DateTime?
  newPickupAt DateTime?
  note        String?
  smsSent     Boolean   @default(false)
  pushSent    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  booking     Booking   @relation(fields: [bookingId], references: [id])

  @@index([bookingId, type])
}


/// Raw AeroDataBox Flight Alert notifications (step 5a capture).
/// Provider data — deleted after 6 days by the retention block in server.ts.
model FlightWebhookEvent {
  id             String   @id @default(uuid())
  receivedAt     DateTime @default(now())
  subscriptionId String?
  flightNumber   String?
  flightCount    Int      @default(0)
  balance        Int?
  payload        Json
  notificationId String?   // AeroDataBox notification id (de-dupe itself is in Redis)
  processedAt    DateTime?
  outcome        String?   // step 5b: "applied …", "shadow …", "duplicate", "no open watch …"

  @@index([receivedAt])
  @@index([subscriptionId])
  @@index([notificationId])
}

/// Every SMS Twilio accepted, with its delivery status (Twilio status callbacks).
/// Phone stored as last 4 digits only. 30-day retention (5-min loop in server.ts).
model SmsMessage {
  id            String    @id @default(uuid())
  sid           String    @unique // Twilio MessageSid
  purpose       String // FLIGHT_PASSENGER | FLIGHT_DRIVER_BACKUP | ADMIN_ALERT | OTP | DRIVER_APPLICATION | TEST
  bookingId     String?
  flightEventId String? // BookingFlightEvent.id (no FK: this is a log)
  toLast4       String
  sender        String? // alphanumeric sender id or our number
  status        String // queued | sending | sent | delivered | undelivered | failed | ...
  errorCode     String?
  alertedAt     DateTime? // admin alert sent (at most once)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([createdAt])
  @@index([bookingId])
}